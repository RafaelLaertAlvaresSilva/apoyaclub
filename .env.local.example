# Copia este archivo como .env.local y rellena los valores con los de tu
# proyecto de Supabase (Project Settings -> API). NUNCA subas .env.local
# al repositorio (ya está incluido en .gitignore).

# URL del proyecto y clave anónima (públicas, se usan en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# Clave de rol de servicio (SECRETA). Solo se usa en el servidor para
# asignar el rol (club/empresa) del usuario al registrarse.
# Project Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-de-servicio

# URL pública del sitio (sin barra final). Se usa para que las tarjetas
# de Open Graph (compartir la página de un club por WhatsApp, etc.) se
# generen con URLs absolutas correctas.
# En local puedes dejar la que hay por defecto; en producción, pon el
# dominio real (ej. https://apoyaclub.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envío de email transaccional con Resend (Fase 8: aviso al club cuando
# una empresa solicita contacto). Crea una cuenta gratuita en
# https://resend.com, genera una API key y ponla aquí.
# RESEND_FROM_EMAIL es la dirección remitente: mientras no verifiques un
# dominio propio en Resend, solo puedes usar "onboarding@resend.dev" (y
# los emails solo llegarán a la cuenta con la que te registraste en
# Resend). Si dejas estas dos variables sin rellenar, la plataforma sigue
# funcionando igual: la solicitud se crea y aparece en el panel del club,
# solo que no se envía el email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Suscripción de los clubes con Stripe (Fase 10). Crea una cuenta
# gratuita en https://dashboard.stripe.com/register y trabaja siempre
# en modo test (interruptor "Test mode" arriba a la derecha) mientras
# desarrollas: las claves de test empiezan por sk_test_/pk_test_ y no
# mueven dinero real.
#
# 1. Developers -> API keys -> copia la "Secret key".
STRIPE_SECRET_KEY=

# 2. Product catalog -> Add product: nombre "Suscripción ApoyaClub",
#    precio recurrente de 29,90 EUR, cada 1 mes, "Tax behavior:
#    Inclusive" (así el club siempre ve 29,90€ finales, sin añadir IVA
#    aparte). Copia el id del Price (empieza por price_), no el del
#    producto (prod_).
STRIPE_PRICE_ID=

# 3. Developers -> Webhooks -> Add endpoint, con la URL
#    https://tu-dominio/api/stripe/webhook (o, en local, la que te da
#    `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#    con la CLI de Stripe: https://stripe.com/docs/stripe-cli).
#    Eventos a escuchar: checkout.session.completed,
#    customer.subscription.created, customer.subscription.updated,
#    customer.subscription.deleted. Copia el "Signing secret"
#    (empieza por whsec_).
STRIPE_WEBHOOK_SECRET=

# 4. Un secreto cualquiera que tú elijas (ej. una cadena aleatoria
#    larga) para proteger el cron diario de avisos de caducidad
#    (api/cron/subscription-reminders). En Vercel, pon la misma cadena
#    como variable de entorno CRON_SECRET del proyecto: Vercel se
#    encarga de enviarla automáticamente al llamar al cron.
CRON_SECRET=

# Formulario de contacto de la landing (Fase 13). Tu email: ahí llegará
# cada mensaje que se envíe desde el formulario de "¿Tienes dudas?
# Escríbenos" de la página de inicio, con el remitente puesto como
# "responder a" para poder contestarle directamente. Usa el mismo envío
# por Resend que el resto de la aplicación (RESEND_API_KEY /
# RESEND_FROM_EMAIL, arriba): sin esas dos variables tampoco llegará
# este email.
CONTACT_EMAIL=

# Alta de administradores (Fase 12). Un secreto cualquiera que tú
# elijas (una cadena aleatoria larga): hace falta para poder crear una
# cuenta de administrador desde /registro-admin (una página sin enlace
# público, pensada solo para el equipo de ApoyaClub). Sin esta variable
# configurada en el servidor, nadie puede crear una cuenta de admin.
ADMIN_SIGNUP_KEY=
